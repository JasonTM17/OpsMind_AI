{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsmind.invalid/evaluation/v1/held-out-manifest.schema.json",
  "title": "OpsMindHeldOutManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "version",
    "payload_root_environment",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "opsmind-held-out-manifest-v1"
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "payload_root_environment": {
      "const": "OPS_EVALUATION_HELDOUT_ROOT"
    },
    "cases": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "family_id",
          "relative_path",
          "content_digest",
          "byte_size",
          "added_at",
          "contamination_tag"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 96
          },
          "family_id": {
            "type": "string",
            "pattern": "^SIM-[0-9]{2}$"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*\\.json$",
            "maxLength": 256
          },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "added_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "contamination_tag": {
            "enum": ["never-trained", "never-tuned", "quarantined"]
          }
        }
      }
    }
  }
}
