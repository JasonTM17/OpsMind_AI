{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsmind.invalid/evaluation/v1/scenario-ground-truth.schema.json",
  "title": "OpsMindScenarioGroundTruthV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_version",
    "family_id",
    "seed",
    "fixture_path",
    "fixture_digest",
    "tenant_context",
    "incident",
    "source_systems",
    "expected",
    "budgets",
    "versions",
    "training_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "opsmind-scenario-ground-truth-v1"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "scenario_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^SIM-[0-9]{2}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "fixture_path": {
      "type": "string",
      "pattern": "^fixture\\.json$"
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "tenant_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "project_id", "data_classes", "isolation"],
      "properties": {
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "isolation": {
          "const": "single-tenant-synthetic"
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "severity", "service", "deployment_marker_at"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "severity": {
          "enum": ["SEV1", "SEV2", "SEV3", "SEV4"]
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "deployment_marker_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source_systems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connector", "manifest_version", "fixture_mode", "read_only"],
        "properties": {
          "connector": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "manifest_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fixture_mode": {
            "const": true
          },
          "read_only": {
            "const": true
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_status",
        "acceptable_rca_labels",
        "minimum_confidence",
        "minimum_evidence_items",
        "expected_tool_calls",
        "allowed_tool_selectors",
        "abstain_allowed",
        "prohibited_effects"
      ],
      "properties": {
        "terminal_status": {
          "enum": ["COMPLETED", "ABSTAINED", "BUDGET_EXCEEDED", "NO_PROGRESS"]
        },
        "acceptable_rca_labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_evidence_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "expected_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "allowed_tool_selectors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["connector", "operation", "risk_class"],
            "properties": {
              "connector": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "operation": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "risk_class": {
                "const": "read-only"
              }
            }
          }
        },
        "abstain_allowed": {
          "type": "boolean"
        },
        "prohibited_effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "write",
              "approval",
              "cross-tenant-access",
              "secret-exposure",
              "audit-bypass"
            ]
          }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "max_tool_calls",
        "max_evidence_items",
        "max_tokens",
        "max_latency_ms",
        "max_cost_usd"
      ],
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_evidence_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "analysis_schema", "model", "operator_model", "evaluator"],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "analysis_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operator_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evaluator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "training_eligible": {
      "const": false
    }
  }
}
