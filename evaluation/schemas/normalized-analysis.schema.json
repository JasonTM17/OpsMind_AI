{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsmind.invalid/evaluation/v1/normalized-analysis.schema.json",
  "title": "OpsMindNormalizedAnalysisV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "run_id",
    "model_id",
    "prompt_version",
    "schema_version",
    "hypotheses",
    "counter_evidence",
    "missing_evidence",
    "citations",
    "confidence",
    "usage",
    "cost_estimate",
    "requested_tool_calls"
  ],
  "properties": {
    "status": {
      "enum": [
        "complete",
        "need_more_evidence",
        "abstain",
        "provider_unavailable",
        "budget_exceeded"
      ]
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_version": {
      "const": "analysis-v1"
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "explanation", "confidence", "citations"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "citations": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/$defs/citation"
            }
          }
        }
      }
    },
    "counter_evidence": {
      "$ref": "#/$defs/notes"
    },
    "missing_evidence": {
      "$ref": "#/$defs/notes"
    },
    "citations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200000
        }
      }
    },
    "cost_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": {
          "const": "USD"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "requested_tool_calls": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent_id",
          "connector",
          "operation",
          "arguments_digest",
          "rationale"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "format": "uuid"
          },
          "connector": {
            "enum": ["metrics", "logs", "traces", "changes", "runbooks"]
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "arguments_digest": {
            "$ref": "#/$defs/digest"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "digest", "claim"],
      "properties": {
        "evidence_id": {
          "type": "string",
          "format": "uuid"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
