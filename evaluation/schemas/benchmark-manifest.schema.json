{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsmind.invalid/evaluation/v1/benchmark-manifest.schema.json",
  "title": "OpsMindBenchmarkManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "version",
    "evidence_level",
    "training_eligible",
    "held_out_manifest_path",
    "scenario_families"
  ],
  "properties": {
    "schema_version": {
      "const": "opsmind-benchmark-manifest-v1"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidence_level": {
      "const": "deterministic-smoke"
    },
    "training_eligible": {
      "const": false
    },
    "held_out_manifest_path": {
      "const": "evaluation/held-out/manifest.yaml"
    },
    "scenario_families": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_id", "scenario_id", "status"],
        "properties": {
          "family_id": {
            "type": "string",
            "pattern": "^SIM-[0-9]{2}$"
          },
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "enum": ["implemented", "pending", "reserved"]
          },
          "ground_truth_path": {
            "type": "string",
            "pattern": "^evaluation/scenarios/[a-z0-9-]+/ground-truth\\.json$"
          },
          "fixture_path": {
            "type": "string",
            "pattern": "^evaluation/scenarios/[a-z0-9-]+/fixture\\.json$"
          },
          "fixture_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
