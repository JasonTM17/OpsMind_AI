{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsmind.invalid/incidents/incident-activity-timeline-page.schema.json",
  "title": "Incident Activity Timeline Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "pageSize", "hasMore"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "./incident-activity-timeline-entry.schema.json" }
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "nextPageToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "hasMore": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "hasMore": { "const": true } },
        "required": ["hasMore"]
      },
      "then": {
        "required": ["nextPageToken"]
      },
      "else": {
        "not": {
          "required": ["nextPageToken"]
        }
      }
    }
  ]
}
